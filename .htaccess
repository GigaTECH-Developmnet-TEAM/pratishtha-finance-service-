# Pratishtha Finance Services - Apache / cPanel settings
AddDefaultCharset UTF-8
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
# One canonical address: https://www.pratishtha.pro  (http -> https and apex -> www, single 301)
# If you use Cloudflare/another proxy and get a redirect loop, replace the HTTPS test with:
#   RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+?)(?::\d+)?$ [NC]
RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]
# index.html is the home page; never expose it as a second URL
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/json application/javascript image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType application/manifest+json "access plus 1 week"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/plain "access plus 1 day"
ExpiresByType application/xml "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
# Turn on ONLY after https works on every page (it tells browsers to always use https):
# Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

AddType application/manifest+json .webmanifest
